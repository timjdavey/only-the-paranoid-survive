# Copy to .env and fill in. See docs/harness/models.md for which runs need which.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
# Folder of held-out skin TOML files. Leave unset to run the public example skin only.
PARANOID_SKINS=
# Folder holding held-out.txt, the held-out seed list. Leave unset to run the public seeds only.
PARANOID_SEEDS=
